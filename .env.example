# ═══════════════════════════════════════════════════════════
# SCORPION ELITE - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════
# COPIA este archivo a .env y completa los valores
# ⚠️ NUNCA subas el archivo .env a GitHub

# ─────────────────────────────────────────────────────────────
# 🔐 SEGURIDAD - NO COMPARTIR ESTE ARCHIVO
# ─────────────────────────────────────────────────────────────

# Contraseña de administrador (login)
ADMIN_PASSWORD=tu_contraseña_segura

# ─────────────────────────────────────────────────────────────
# 🗄️ SUPABASE
# ─────────────────────────────────────────────────────────────

# URL de tu proyecto Supabase
SUPABASE_URL=https://xxxxx.supabase.co

# Key anon/public de Supabase (empieza con eyJ...)
SUPABASE_KEY=eyJhbGci...

# ─────────────────────────────────────────────────────────────
# ⚽ API-FOOTBALL (opcional - para stats avanzadas)
# ─────────────────────────────────────────────────────────────

API_FOOTBALL_KEY=tu_api_key
